# انسخ هذا الملف إلى backend/.env وعدّل القيم قبل النشر.
# لتوليد سر قوي:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=production
PORT=5000
TRUST_PROXY=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Ageel_phone
DB_USER=shop_user
DB_PASS=CHANGE_ME
DB_SSL=false
DB_SYNC=true
DB_POOL_MAX=10

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
RECOVERY_JWT_SECRET=CHANGE_ME_MIN_32_CHARS
TOKEN_EXPIRES_IN=1d
RECOVERY_TOKEN_EXPIRES_IN=10m
BCRYPT_ROUNDS=12

RATE_LIMIT_API_WINDOW_MIN=15
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MIN=15
RATE_LIMIT_LOGIN_MAX=8
BODY_LIMIT=32kb

# اتركها فارغة إذا كان الموقع يُخدَم من نفس المصدر (Express يقدّم الواجهة)
CORS_ORIGINS=

STORE_NAME=TechGadget
# اتركهما فارغاً حتى تحدّد بيانات المتجر الحقيقية؛ القيم النموذجية تُحجب تلقائياً.
TELEGRAM_USERNAME=
SUPPORT_EMAIL=

# يستخدمها فقط: npm run seed:admin
SEED_ADMIN_NAME=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASS_KEY=
SEED_ADMIN_RECOVERY_CODE=
